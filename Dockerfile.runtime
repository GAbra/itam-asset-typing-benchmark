FROM eclipse-temurin:21-jre
WORKDIR /workspace
LABEL org.opencontainers.image.title="ITAM Asset Typing Benchmark" \
      org.opencontainers.image.source="https://github.com/GAbra/itam-asset-typing-benchmark" \
      org.opencontainers.image.licenses="MIT"
COPY rules/canonical-rules.yaml /workspace/rules/canonical-rules.yaml
COPY target/itam-asset-typing-benchmark-2.0.0.jar /opt/itam/itam-asset-typing-benchmark.jar
ENTRYPOINT ["java", "-jar", "/opt/itam/itam-asset-typing-benchmark.jar"]
